#!/sbin/openrc-run

# backward compatibility for existing gentoo layout
#
if [ -d "/var/lib/lithiumd" ]; then
	LITHIUMD_DEFAULT_DATADIR="/var/lib/lithiumd"
else
	LITHIUMD_DEFAULT_DATADIR="/var/lib/lithiumd"
fi

LITHIUMD_CONFIGFILE=${LITHIUMD_CONFIGFILE:-/etc/lithium/lithium.conf}
LITHIUMD_PIDDIR=${LITHIUMD_PIDDIR:-/var/run/lithiumd}
LITHIUMD_PIDFILE=${LITHIUMD_PIDFILE:-${LITHIUMD_PIDDIR}/lithiumd.pid}
LITHIUMD_DATADIR=${LITHIUMD_DATADIR:-${LITHIUMD_DEFAULT_DATADIR}}
LITHIUMD_USER=${LITHIUMD_USER:-${LITHIUM_USER:-lithium}}
LITHIUMD_GROUP=${LITHIUMD_GROUP:-lithium}
LITHIUMD_BIN=${LITHIUMD_BIN:-/usr/bin/lithiumd}
LITHIUMD_NICE=${LITHIUMD_NICE:-${NICELEVEL:-0}}
LITHIUMD_OPTS="${LITHIUMD_OPTS:-${LITHIUM_OPTS}}"

name="Lithium Daemon"
description="Lithium cryptocurrency P2P network daemon"

command="/usr/bin/lithiumd"
command_args="-pid=\"${LITHIUMD_PIDFILE}\" \
		-conf=\"${LITHIUMD_CONFIGFILE}\" \
		-datadir=\"${LITHIUMD_DATADIR}\" \
		-daemon \
		${LITHIUMD_OPTS}"

required_files="${LITHIUMD_CONFIGFILE}"
start_stop_daemon_args="-u ${LITHIUMD_USER} \
			-N ${LITHIUMD_NICE} -w 2000"
pidfile="${LITHIUMD_PIDFILE}"

# The retry schedule to use when stopping the daemon. Could be either
# a timeout in seconds or multiple signal/timeout pairs (like
# "SIGKILL/180 SIGTERM/300")
retry="${LITHIUMD_SIGTERM_TIMEOUT}"

depend() {
	need localmount net
}

# verify
# 1) that the datadir exists and is writable (or create it)
# 2) that a directory for the pid exists and is writable
# 3) ownership and permissions on the config file
start_pre() {
	checkpath \
	-d \
	--mode 0750 \
	--owner "${LITHIUMD_USER}:${LITHIUMD_GROUP}" \
	"${LITHIUMD_DATADIR}"

	checkpath \
	-d \
	--mode 0755 \
	--owner "${LITHIUMD_USER}:${LITHIUMD_GROUP}" \
	"${LITHIUMD_PIDDIR}"

	checkpath -f \
	-o "${LITHIUMD_USER}:${LITHIUMD_GROUP}" \
	-m 0660 \
	"${LITHIUMD_CONFIGFILE}"

	checkconfig || return 1
}

checkconfig()
{
	if grep -qs '^rpcuser=' "${LITHIUMD_CONFIGFILE}" && \
		! grep -qs '^rpcpassword=' "${LITHIUMD_CONFIGFILE}" ; then
		eerror ""
		eerror "ERROR: You must set a secure rpcpassword to run lithiumd."
		eerror "The setting must appear in ${LITHIUMD_CONFIGFILE}"
		eerror ""
		eerror "This password is security critical to securing wallets "
		eerror "and must not be the same as the rpcuser setting."
		eerror "You can generate a suitable random password using the following "
		eerror "command from the shell:"
		eerror ""
		eerror "bash -c 'tr -dc a-zA-Z0-9 < /dev/urandom | head -c32 && echo'"
		eerror ""
		eerror "It is recommended that you also set alertnotify so you are "
		eerror "notified of problems:"
		eerror ""
		eerror "ie: alertnotify=echo %%s | mail -s \"Lithium Alert\"" \
			"admin@foo.com"
		eerror ""
		return 1
	fi
}
